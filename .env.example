# WalletConnect Cloud project id (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Public site URL used for OG / share cards
VITE_SITE_URL=http://localhost:5173

# Optional: OpenAI-compatible key for narrator beats. If empty, a template generator is used.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Optional Vercel KV. Local dev falls back to .data/store.json
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cron secret so /api/cron is not public
CRON_SECRET=change-me

# Sepolia RPC (read-only). Default is the public endpoint.
SEPOLIA_RPC_URL=https://rpc.sepolia.org
